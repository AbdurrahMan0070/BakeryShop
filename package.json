{
  "name": "bakery-shop",
  "version": "1.0.0",
  "private": true,
  "description": "Full-stack Bakery Shop application",
  "scripts": {
    "install:all": "cd bakery-backend && npm install && cd ../bakery-frontend && npm install",
    "build": "npm run build:backend && npm run build:frontend",
    "build:backend": "cd bakery-backend && npm run vercel-build",
    "build:frontend": "cd bakery-frontend && npm run build",
    "vercel-build": "npm run install:all && npm run build",
    "dev:backend": "cd bakery-backend && npm run start:dev",
    "dev:frontend": "cd bakery-frontend && npm run dev",
    "start": "cd bakery-backend && npm run start:prod"
  },
  "workspaces": [
    "bakery-backend",
    "bakery-frontend"
  ]
}
